{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,

	"settings": {
		"appearanceTools": true,

		"layout": {
			"contentSize": "48rem",
			"wideSize": "82rem"
		},

		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"link": true,

			"palette": [
				{ "slug": "navy",       "color": "#1d4e89", "name": "Navy" },
				{ "slug": "navy-deep",  "color": "#0b2341", "name": "Navy deep" },
				{ "slug": "ink",        "color": "#071a31", "name": "Ink" },
				{ "slug": "cyan",       "color": "#28abe5", "name": "Cyan" },
				{ "slug": "cyan-soft",  "color": "#dff4fc", "name": "Cyan soft" },
				{ "slug": "mint",       "color": "#8fd7f3", "name": "Mint" },
				{ "slug": "text",       "color": "#232324", "name": "Text" },
				{ "slug": "text-soft",  "color": "#5c6673", "name": "Text soft" },
				{ "slug": "white",      "color": "#ffffff", "name": "White" },
				{ "slug": "paper",      "color": "#f3f5f8", "name": "Paper" },
				{ "slug": "paper-blue", "color": "#edf5fa", "name": "Paper blue" }
			],

			"gradients": [
				{ "slug": "brand",      "name": "Brand",      "gradient": "linear-gradient(45deg, #1d4e89 0%, #28abe5 100%)" },
				{ "slug": "brand-deep", "name": "Brand deep", "gradient": "linear-gradient(45deg, #1d4e89 30%, #28abe5 100%)" }
			]
		},

		"typography": {
			"fluid": false,
			"defaultFontSizes": false,
			"customFontSize": false,
			"lineHeight": true,
			"dropCap": false,
			"writingMode": false,
			"textAlign": true,

			"fontFamilies": [
				{
					"slug": "brand",
					"name": "Montserrat",
					"fontFamily": "\"Montserrat\", \"Avenir Next\", \"Segoe UI\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat-latin.woff2" ]
						}
					]
				}
			],

			"fontSizes": [
				{ "slug": "sm",   "name": "Small",     "size": "clamp(0.82rem, 0.8rem + 0.1vw, 0.9rem)" },
				{ "slug": "base", "name": "Body",      "size": "clamp(1rem, 0.95rem + 0.2vw, 1.12rem)" },
				{ "slug": "lg",   "name": "Lede",      "size": "clamp(1.2rem, 1.05rem + 0.55vw, 1.55rem)" },
				{ "slug": "xl",   "name": "Heading 3", "size": "clamp(1.55rem, 1.2rem + 1.1vw, 2.25rem)" },
				{ "slug": "xxl",  "name": "Heading 2", "size": "clamp(2.1rem, 1.45rem + 2.2vw, 3.5rem)" },
				{ "slug": "xxxl", "name": "Heading 1", "size": "clamp(2.8rem, 1.7rem + 3.8vw, 5.8rem)" }
			]
		},

		"spacing": {
			"units": [ "rem", "%", "vw", "px" ],
			"padding": true,
			"margin": true,
			"blockGap": true,
			"defaultSpacingSizes": false,
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "name": "1 — Hair",    "size": "0.5rem" },
				{ "slug": "30", "name": "2 — Tight",   "size": "0.75rem" },
				{ "slug": "40", "name": "3 — Base",    "size": "1rem" },
				{ "slug": "50", "name": "4 — Comfort", "size": "1.5rem" },
				{ "slug": "60", "name": "5 — Loose",   "size": "2rem" },
				{ "slug": "70", "name": "6 — Block",   "size": "3rem" },
				{ "slug": "80", "name": "7 — Band",    "size": "4rem" },
				{ "slug": "90", "name": "8 — Section", "size": "clamp(2.8rem, 4.5vw, 4.9rem)" }
			]
		},

		"border": { "color": true, "radius": true, "style": true, "width": true },

		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Soft", "shadow": "0 1.5rem 4rem rgba(7, 26, 49, 0.12)" },
				{ "slug": "card", "name": "Card", "shadow": "0 1rem 2.5rem rgba(7, 26, 49, 0.09)" }
			]
		},

		"custom": {
			"containerNarrow": "68rem",
			"gutter": "clamp(1.25rem, 4vw, 3.5rem)",
			"gutterNarrow": "clamp(1rem, 4.5vw, 1.35rem)",
			"headerHeight": "5.25rem",
			"headerHeightCompact": "4.75rem",
			"color": {
				"border": "#d7e1e9",
				"borderDark": "rgba(255, 255, 255, 0.16)",
				"focus": "#ffd15c",
				"success": "#8dd8b4"
			},
			"radius": {
				"sm": "4px",
				"md": "6px",
				"lg": "8px",
				"xl": "8px"
			},
			"motion": {
				"easeOut": "cubic-bezier(0.2, 0.75, 0.25, 1)",
				"durationFast": "160ms",
				"duration": "320ms",
				"durationSlow": "650ms"
			}
		}
	},

	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--text)"
		},

		"typography": {
			"fontFamily": "var(--wp--preset--font-family--brand)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.65"
		},

		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)"
		},

		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--navy)" },
				":hover": { "color": { "text": "var(--wp--preset--color--cyan)" } },
				":focus": {
					"outline": {
						"color": "var(--wp--custom--color--focus)",
						"style": "solid",
						"width": "3px",
						"offset": "2px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--brand)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				},
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xxxl)", "lineHeight": "1.05" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--base)", "fontWeight": "700" } },
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--sm)",
					"fontWeight": "700",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em"
				},
				"color": { "text": "var(--wp--preset--color--text-soft)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--navy)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "var(--wp--custom--radius--md)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--brand)",
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "600"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem", "bottom": "0.9rem",
						"left": "1.75rem", "right": "1.75rem"
					}
				},
				":hover": { "color": { "background": "var(--wp--preset--color--cyan)" } },
				":focus": {
					"outline": {
						"color": "var(--wp--custom--color--focus)",
						"style": "solid",
						"width": "3px",
						"offset": "2px"
					}
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--sm)" },
				"color": { "text": "var(--wp--preset--color--text-soft)" }
			}
		},

		"blocks": {
			"core/separator": {
				"color": { "text": "var(--wp--custom--color--border)" }
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--cyan)",
						"style": "solid",
						"width": "3px"
					}
				},
				"spacing": { "padding": { "left": "var(--wp--preset--spacing--50)" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--lg)" }
			}
		}
	}
}
